# Copia este archivo a .env y cambia TODOS los valores "cambia_esto"
# Genera claves con:  openssl rand -hex 24

TIMEZONE=America/Mexico_City

# Postgres administrador (lo usa n8n para su base interna)
POSTGRES_ADMIN_USER=gym_admin
POSTGRES_ADMIN_PASSWORD=cambia_esto

# Usuario restringido para los datos del gimnasio (credencial de n8n "Gym DB")
GYM_APP_USER=gym_app
GYM_APP_PASSWORD=cambia_esto

# Clave con la que n8n cifra tus credenciales. NO la pierdas ni la cambies después.
N8N_ENCRYPTION_KEY=cambia_esto

# Local:            N8N_HOST=localhost  N8N_PROTOCOL=http  WEBHOOK_URL=https://<tu-tunel>.trycloudflare.com/
# Servidor/dominio: N8N_HOST=n8n.tudominio.com  N8N_PROTOCOL=https  WEBHOOK_URL=https://n8n.tudominio.com/
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=https://cambia_esto/
